<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F7"
    android:padding="12dp"
    tools:ignore="HardcodedText">

    <!-- Display Screen Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textColor="#757575"
            android:textSize="20sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="#212121"
            android:textSize="44sp"
            android:maxLines="1"
            android:ellipsize="start" />
    </LinearLayout>

    <!-- Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.8"
        android:columnCount="4"
        android:rowCount="7"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <!-- Row 1: Scientific Functions -->
        <Button android:id="@+id/btnSin" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="sin" android:textSize="16sp" android:textColor="#000000" android:backgroundTint="#E0E0E0" />
        <Button android:id="@+id/btnCos" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="cos" android:textSize="16sp" android:textColor="#000000" android:backgroundTint="#E0E0E0" />
        <Button android:id="@+id/btnTan" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="tan" android:textSize="16sp" android:textColor="#000000" android:backgroundTint="#E0E0E0" />
        <Button android:id="@+id/btnLog" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="log" android:textSize="16sp" android:textColor="#000000" android:backgroundTint="#E0E0E0" />

        <!-- Row 2 -->
        <Button android:id="@+id/btnLn" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="ln" android:textSize="16sp" android:textColor="#000000" android:backgroundTint="#E0E0E0" />
        <Button android:id="@+id/btnSqrt" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="√" android:textSize="20sp" android:textColor="#000000" android:backgroundTint="#E0E0E0" />
        <Button android:id="@+id/btnPower" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="^" android:textSize="20sp" android:textColor="#000000" android:backgroundTint="#E0E0E0" />
        <Button android:id="@+id/btnPi" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="pi" android:textSize="16sp" android:textColor="#000000" android:backgroundTint="#E0E0E0" />

        <!-- Row 3 -->
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="C" android:textSize="20sp" android:textColor="#D32F2F" android:backgroundTint="#FFCDD2" />
        <Button android:id="@+id/btnOpenBracket" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="(" android:textSize="20sp" android:textColor="#1976D2" android:backgroundTint="#E3F2FD" />
        <Button android:id="@+id/btnCloseBracket" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text=")" android:textSize="20sp" android:textColor="#1976D2" android:backgroundTint="#E3F2FD" />
        <Button android:id="@+id/btnBackspace" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="⌫" android:textSize="18sp" android:textColor="#1976D2" android:backgroundTint="#E3F2FD" />

        <!-- Row 4 -->
        <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="7" android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="8" android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="9" android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btnDivide" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="/" android:textSize="22sp" android:textColor="#1976D2" android:backgroundTint="#E3F2FD" />

        <!-- Row 5 -->
        <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="4" android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="5" android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="6" android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btnMultiply" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="*" android:textSize="22sp" android:textColor="#1976D2" android:backgroundTint="#E3F2FD" />

        <!-- Row 6 -->
        <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="1" android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="2" android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="3" android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btnMinus" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="-" android:textSize="24sp" android:textColor="#1976D2" android:backgroundTint="#E3F2FD" />

        <!-- Row 7 -->
        <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="." android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="0" android:textSize="22sp" android:textColor="#212121" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btnEqual" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="=" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#1976D2" />
        <Button android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="+" android:textSize="22sp" android:textColor="#1976D2" android:backgroundTint="#E3F2FD" />

    </GridLayout>
</LinearLayout>